# Bytecode e cache do Python
__pycache__/
*.pyc

# Ambientes virtuais
.venv/
venv/

# Relatorios gerados pela execucao do script (main.py e
# test/localstack/run_test.sh) — contem ARNs, contas e estrutura de OU
# reais, nunca devem ser versionados
relatorio*.json
prm_mapping_report.json
prm_decision_report.json
prm_apply_report.json
# Convencao para saida de testes manuais/smoke contra sandbox (--output
# qualquer_nome_teste.json) — nomes customizados nao cabem num padrao fixo,
# entao a convencao e usar sempre o sufixo "_teste.json"
*_teste.json
# Rede de seguranca para o mesmo caso: nomes de saida de teste que nao
# seguem o sufixo acima (ex.: resultado_um_recurso_dry.json), mas comecam
# com um destes prefixos — tambem contem ARNs/conta real.
mapa*.json
decisao*.json
resultado*.json

# SO / editor
.DS_Store
